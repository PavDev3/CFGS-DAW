package examen4;

import simulacro.alumno;
import testExamMarIA.ProductoInvalidoException;

public class Producto {
	// Atributos
	private String nombre;
	private int stock;
	private double precio;
	
	
	private Producto(String nombre, double precio, int stock) {
		this.nombre = nombre;
		this.precio = precio;
		this.stock = stock;
	}
	
	// getter 
	
	// metodo para obtener el stock
	public int getStock() {
		return stock;	
	}
	
	// Metodo para obtener el precio
	public double getPrecio() {
		return precio;
	}
	
	// metodo para obtener Nombre
	public String getNombre() {
		return nombre;
	}
	
	// Setter 
	
	// Metodo para asignacion de Nombre
	public void setNombre(String nombre) {
	 // Hacemos try catch para capturar posibles errores
		try {
			// si el nombre es nulo o tiene espacio lo capturamos con la exception
			if (nombre == null || nombre.trim().isEmpty()) {
				throw new ProductoInvalidoException("El nombre no puede estar en blanco");
			}
			// si todo ok le asignamos nombre
			this.nombre = nombre;
			// Al capturar lanzamos la excetion y el mensaje
		} catch (ProductoInvalidoException e) {
			System.out.println("Error al establecer el nombre: " + e.getMessage());
		}
	}

	// Metodo para asignacion de precio.
	public void setPrecio(double precio) {
		// arrancamos con try catch para posibles errores
		try {
			// si el precio es menor de 0 lo capturamos con la excepcion 
			if (precio < 0) {
				throw new ProductoInvalidoException("El precio no puede ser negativo");
			}
			// Si todo esta ok se le asigna a la variable el valor.
			this.precio = precio;
		} catch (ProductoInvalidoException e) {
			System.out.println(e.getMessage());
		}
	}

	public void setStock(int stock) {
		try {
			if (stock < 0) {
				throw new ProductoInvalidoException("El stock no puede ser negativo.");
			}
			this.stock = stock;
		} catch (ProductoInvalidoException e) {
			System.out.println("Error al establecer el stock: " + e.getMessage());
		}
	}
	
	public int compareTo(Producto a) {	
		if (this.precio < a.getPrecio()) {
			return -1;
		}
		else if (this.precio > a.getPrecio()) {
			return 1;
		}
		else {
			return 0;
		}
	}
}
